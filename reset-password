#!/bin/sh
# Reset the WebUI login to admin / <password>.
# Usage: reset-password [password]   (a random one is generated when omitted)
#
# qBittorrent keeps its settings in memory and rewrites the config file, so
# the new hash is staged here and applied by docker-entrypoint.sh on the next
# container start.
set -e

password="${1:-$(head -c 9 /dev/urandom | base64 | tr '+/' 'ab')}"

hex() { od -An -v -tx1 | tr -d ' \n'; }

# Same scheme as qBittorrent: PBKDF2-HMAC-SHA512, 100000 rounds, 16-byte salt
salt="$(head -c 16 /dev/urandom | base64)"
hash="$(openssl kdf -binary -keylen 64 \
    -kdfopt digest:SHA512 \
    -kdfopt iter:100000 \
    -kdfopt "hexsalt:$(printf '%s' "$salt" | base64 -d | hex)" \
    -kdfopt "hexpass:$(printf '%s' "$password" | hex)" \
    PBKDF2 | base64 -w 0)"

umask 077
printf 'WebUI\\Password_PBKDF2="@ByteArray(%s:%s)"\n' "$salt" "$hash" > /data/.reset-password

echo "username: admin"
echo "password: $password"
echo "Restart the container to apply (docker restart <name>)."
